pipeline {
    agent any

    stages {

        stage('Clone Repository') {
            steps {
                git branch: 'dev', url: 'https://github.com/Serayasaravanan/flask-cicd-project.git'
            }
        }

        stage('Build Docker Image') {
            steps {
                sh 'docker build -t flask-cicd .'
            }
        }

        stage('Stop Old Container') {
            steps {
                sh 'docker rm -f flask-container || true'
            }
        }

        stage('Run Docker Container') {
            steps {
                sh 'docker run -d -p 5000:5000 --name flask-container flask-cicd'
            }
        }
    }
}
